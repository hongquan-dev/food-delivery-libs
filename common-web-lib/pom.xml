<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>food-delivery-libs</artifactId>
        <version>1.0.0-SNAPSHOT</version>
<!--        <version>1.0.0</version>-->
    </parent>

    <artifactId>common-web-lib</artifactId>
    <packaging>jar</packaging>

    <name>Food Delivery :: Common Web Library</name>
    <description>Spring MVC side of the API response format: ResponseHandler, ApiResponseWriter, BusinessException and GlobalExceptionHandler</description>

    <dependencies>
        <!-- ApiResponse, ApiStatus, FieldErrorDetail, PageMeta -->
        <dependency>
            <groupId>com.fooddelivery</groupId>
            <artifactId>common-dto-lib</artifactId>
        </dependency>
        <!-- ResponseEntity, HttpHeaders, HttpStatusCode -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- ApiResponseWriter serializes ApiResponse with the application's ObjectMapper -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Fallback ObjectMapper of ApiResponseWriter: serializes ApiResponse.timestamp (Instant) as ISO-8601 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <!-- CommonWebAutoConfiguration registers GlobalExceptionHandler and ApiResponseWriter in every Spring Boot
             service -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- GlobalExceptionHandler logs errors through the services' Log4j2 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <!-- ResponseHandler reads the current request path and ApiResponseWriter writes to the servlet response;
             provided by the servlet container of the service -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>