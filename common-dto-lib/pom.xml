         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>food-delivery-libs</artifactId>
        <version>1.0.0-SNAPSHOT</version>
<!--        <version>1.0.0</version>-->
    </parent>

    <artifactId>common-dto-lib</artifactId>
    <packaging>jar</packaging>

    <name>Food Delivery :: Common DTO Library</name>
    <description>Plain Java models shared by every service: API response format (ApiResponse, ApiStatus, FieldErrorDetail, PageMeta), shared enums and DTOs exchanged between services</description>

    <dependencies>
        <!-- @JsonInclude, @JsonPropertyOrder on ApiResponse. The only dependency, so the models work with or without
             Spring MVC, e.g. in the WebFlux gateway -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
    </dependencies>
</project>